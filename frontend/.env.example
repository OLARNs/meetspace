# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องตัวเอง:  cp .env.example .env
# (.env ตัวจริงถูก .gitignore ไว้ ไม่ขึ้น git)

# URL ของ NestJS API — ฝั่ง server ใช้เรียกผ่าน BFF เท่านั้น เบราว์เซอร์ไม่เรียก API ตรง
# จึงไม่ต้องมี NEXT_PUBLIC_ นำหน้า (ค่านี้ไม่หลุดไปหน้าเว็บ)
API_URL="http://localhost:3001"

# secret ของ next-auth v5 ใช้เซ็น session cookie — สร้างด้วย: pnpm exec auth secret
AUTH_SECRET=""

# Google OAuth — next-auth v5 อ่านชื่อตัวแปร AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET อัตโนมัติ
# AUTH_GOOGLE_ID ต้องเป็นค่าเดียวกับ GOOGLE_CLIENT_ID ฝั่ง backend
# Authorized redirect URI ที่ต้องใส่ใน Google Console:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
