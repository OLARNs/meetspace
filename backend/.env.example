# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องตัวเอง:  cp .env.example .env
# (.env ตัวจริงถูก .gitignore ไว้ ไม่ขึ้น git)

# Postgres connection string — ต้องสร้าง database ชื่อ meetspace ไว้ก่อน
DATABASE_URL="postgresql://postgres:password@localhost:5432/meetspace?schema=public"

# secret สำหรับเซ็น access token — สุ่มเองด้วย: openssl rand -base64 32
JWT_SECRET="replace-me"

# secret แยกสำหรับ refresh token (ต้องคนละตัวกับ access เพื่อไม่ให้ใช้แทนกันได้)
JWT_REFRESH_SECRET="replace-me-too"

# Client ID ของ Google OAuth — ใช้ตรวจ audience ตอน verify id_token ที่ frontend ส่งมา
# สร้างที่ https://console.cloud.google.com → APIs & Services → Credentials
# ต้องเป็นตัวเดียวกับ AUTH_GOOGLE_ID ฝั่ง frontend
# ถ้าไม่ต้องการ Google login ปล่อยว่างได้ (ปุ่ม Google จะใช้ไม่ได้ แต่ login ปกติยังทำงาน)
GOOGLE_CLIENT_ID=""

# Cloudinary (อัปโหลดรูปโปรไฟล์) — copy CLOUDINARY_URL จาก dashboard มาวางทั้งเส้น
# รูปแบบ: cloudinary://<api_key>:<api_secret>@<cloud_name>
# ถ้าไม่ต้องการอัปโหลดรูป ปล่อยว่างได้
CLOUDINARY_URL=""

PORT=3001
