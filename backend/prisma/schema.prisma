generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
}

model User {
  id             String               @id @default(uuid())
  name           String
  email          String               @unique
  // nullable: ผู้ใช้ที่ login ด้วย Google จะไม่มีรหัสผ่าน
  password       String?
  role           Role                 @default(USER)
  bookings       Booking[]
  participations BookingParticipant[]
  createdAt      DateTime             @default(now())
  // sha256 ของ refresh token ที่ยัง active (null = ยังไม่ login / logout แล้ว)
  refreshTokenHash String?
  // ผูกกับบัญชี Google (sub) — null = สมัครแบบ email/password ปกติ
  googleId       String?              @unique
}

model Room {
  id        String    @id @default(uuid())
  name      String
  location  String
  capacity  Int
  equipment String[]
  imageUrl  String?
  isActive  Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id           String               @id @default(uuid())
  room         Room                 @relation(fields: [roomId], references: [id])
  roomId       String
  user         User                 @relation(fields: [userId], references: [id])
  userId       String
  title        String
  startTime    DateTime
  endTime      DateTime
  status       BookingStatus        @default(CONFIRMED)
  participants BookingParticipant[]
  createdAt    DateTime             @default(now())

  @@index([roomId, startTime, endTime])
}

model BookingParticipant {
  id        String            @id @default(uuid())
  booking   Booking           @relation(fields: [bookingId], references: [id])
  bookingId String
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  status    ParticipantStatus @default(INVITED)
  createdAt DateTime          @default(now())

  @@unique([bookingId, userId])
}
